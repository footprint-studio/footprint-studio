{
  "name": "@footprint-studio/web-component",
  "version": "1.0.0",
  "description": "Web Component wrapper for footprint-globe",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/footprint-studio/footprint-studio.git",
    "directory": "packages/web-component"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "footprint-globe": "workspace:*"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.5",
    "jsdom": "^24.1.1",
    "maplibre-gl": "^5.4.0",
    "tsup": "^8.2.4",
    "vitest": "^2.0.5"
  }
}
