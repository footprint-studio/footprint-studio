{
  "name": "footprint-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/footprint-studio/footprint-studio.git"
  },
  "homepage": "https://github.com/footprint-studio/footprint-studio",
  "bugs": {
    "url": "https://github.com/footprint-studio/footprint-studio/issues"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @footprint-studio/test test:e2e",
    "test:visual": "pnpm --filter @footprint-studio/test test:visual:chromium",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run --skip-checks",
    "deploy:site": "node scripts/deploy.mjs site",
    "deploy:embed": "node scripts/deploy.mjs embed",
    "deploy:all": "node scripts/deploy.mjs all",
    "build:site": "node scripts/build-site.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.16.0",
    "eslint": "^9.9.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "turbo": "^2.0.12",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.23.1"
    }
  }
}
